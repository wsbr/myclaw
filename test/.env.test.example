# Copy to .env.test and adjust if needed
# Used by integration/e2e tests (in-process mode)

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=myclaw_test
MYSQL_USER=myclaw
MYSQL_PASSWORD=mypassword

DATABASE_URL=mysql+aiomysql://myclaw:mypassword@localhost:3307/myclaw_test
REDIS_URL=redis://:redispassword@localhost:6380/0
SECRET_KEY=test-secret-key-for-jwt-signing-32chars
ENCRYPTION_KEY=test-encryption-key-32-bytes-hex00

DEBUG=true
CORS_ORIGINS=["http://localhost"]

INIT_ADMIN_EMAIL=admin@test.myclaw.local
INIT_ADMIN_PASSWORD=testpassword123

# Docker fullstack mode
MYCLAW_FULLSTACK_API_URL=http://localhost:8001
MYCLAW_FULLSTACK_UI_URL=http://localhost:8081
# Mock LLM — external (health check from host) vs internal (stored in provider, used by api/worker containers)
MYCLAW_MOCK_LLM_URL=http://localhost:9090
MYCLAW_MOCK_LLM_INTERNAL_URL=http://mock-llm:9090

# Final acceptance only. Inject MYCLAW_REAL_LLM_API_KEY from the shell or CI
# secret store; never write its value into this file.
MYCLAW_LLM_MODE=mock
MYCLAW_REAL_LLM_ENDPOINT=
MYCLAW_REAL_LLM_MODEL=
