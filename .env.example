# Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=myclaw
MYSQL_USER=myclaw
MYSQL_PASSWORD=mypassword
DATABASE_URL=mysql+aiomysql://myclaw:mypassword@mysql:3306/myclaw
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@redis:6379/0

# Security
SECRET_KEY=change-me-to-a-random-32-char-string-in-prod
ENCRYPTION_KEY=change-me-to-32-byte-aes-key-hex

# App
DEBUG=false
MYCLAW_ENVIRONMENT=production
CORS_ORIGINS=["http://localhost","http://localhost:3000"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_UNAUTHENTICATED_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Durable Runtime production tuning
RUNTIME_WORKER_POLL_SECONDS=0.5
RUNTIME_OUTBOX_CLAIM_LEASE_SECONDS=30
RUNTIME_RUNNER_LEASE_SECONDS=30
RUNTIME_RUNNER_HEARTBEAT_SECONDS=10
SANDBOX_WORKER_POLL_SECONDS=0.5
SANDBOX_OUTBOX_CLAIM_LEASE_SECONDS=30
SANDBOX_ATTEMPT_STALE_SECONDS=60
MAINTENANCE_POLL_SECONDS=3600
MAINTENANCE_BATCH_SIZE=500
OUTBOX_COMPLETED_RETENTION_DAYS=30
OUTBOX_DEAD_RETENTION_DAYS=180
CHECKPOINT_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30
DELIVERY_ATTEMPT_RETENTION_DAYS=90

# Model credentials are referenced from the registry as env://MYCLAW_MODEL_API_KEY.
# Set the value only in the deployment secret environment; never commit it here.
MYCLAW_MODEL_API_KEY=

# Optional OTLP/HTTP export. Enable the observability Compose profile and set
# this to http://otel-collector:4318, or point it at an external Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
MYCLAW_RELEASE=development

# Frontend (baked in at build time)
VITE_API_BASE_URL=http://localhost:8000

# Initial admin user (created on first startup)
INIT_ADMIN_EMAIL=admin@myclaw.local
INIT_ADMIN_PASSWORD=changeme123
