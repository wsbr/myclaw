# Database
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=myclaw
MYSQL_USER=myclaw
MYSQL_PASSWORD=mypassword
DATABASE_URL=mysql+aiomysql://myclaw:mypassword@mysql:3306/myclaw
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@redis:6379/0

# Security
SECRET_KEY=change-me-to-a-random-32-char-string-in-prod
ENCRYPTION_KEY=change-me-to-32-byte-aes-key-hex

# App
DEBUG=false
MYCLAW_ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:8080","http://localhost:8000"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_UNAUTHENTICATED_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Durable Runtime production tuning
RUNTIME_WORKER_POLL_SECONDS=0.5
RUNTIME_WORKER_CONCURRENCY=8
RUNTIME_PROVIDER_POOL_MAX_ENTRIES=32
RUNTIME_OUTBOX_CLAIM_LEASE_SECONDS=30
RUNTIME_RUNNER_LEASE_SECONDS=30
RUNTIME_RUNNER_HEARTBEAT_SECONDS=10
SANDBOX_WORKER_POLL_SECONDS=0.5
SANDBOX_OUTBOX_CLAIM_LEASE_SECONDS=30
SANDBOX_ATTEMPT_STALE_SECONDS=60
MAINTENANCE_POLL_SECONDS=3600
MAINTENANCE_COMMAND_POLL_SECONDS=1
MAINTENANCE_COMMAND_CLAIM_LEASE_SECONDS=300
MAINTENANCE_COMMAND_HEARTBEAT_SECONDS=30
MAINTENANCE_BATCH_SIZE=500
OUTBOX_COMPLETED_RETENTION_DAYS=30
OUTBOX_DEAD_RETENTION_DAYS=180
CHECKPOINT_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30
DELIVERY_ATTEMPT_RETENTION_DAYS=90

# Skill packages: local is the single-node/UAT adapter. For multi-node use the
# docker-compose.s3.yml overlay or an external S3-compatible object store.
SKILL_STORAGE_BACKEND=local
SKILL_S3_ENDPOINT_URL=http://minio:9000
SKILL_S3_REGION=us-east-1
SKILL_S3_BUCKET=myclaw-skills
SKILL_S3_ACCESS_KEY_ID=myclaw-minio
SKILL_S3_SECRET_ACCESS_KEY=change-me-skill-object-store
SKILL_S3_FORCE_PATH_STYLE=true
SKILL_MANIFEST_MAX_BYTES=262144
SKILL_CATALOG_MAX_TOKENS=600
SKILL_SYNC_WORKER_POLL_SECONDS=1
SKILL_SYNC_CLAIM_LEASE_SECONDS=30
SKILL_SYNC_RECONCILE_SECONDS=3600

# Model credentials are referenced from the registry as env://MYCLAW_MODEL_API_KEY.
# Set the value only in the deployment secret environment; never commit it here.
MYCLAW_MODEL_API_KEY=

# Optional OTLP/HTTP export. Enable the observability Compose profile and set
# this to http://otel-collector:4318, or point it at an external Collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
MYCLAW_RELEASE=development

# Local ports and Frontend API endpoint (baked in at build time)
MYCLAW_UI_PORT=8080
MYCLAW_API_PORT=8000
MYCLAW_MYSQL_PORT=3306
MYCLAW_REDIS_PORT=6379
VITE_API_BASE_URL=http://localhost:8000

# Initial admin user (created on first startup)
INIT_ADMIN_EMAIL=admin@myclaw.local
INIT_ADMIN_PASSWORD=changeme123
# Refuse (rather than truncate) a model-facing Group candidate catalog above this size.
EMERGENT_GROUP_MAX_CANDIDATES=100
# Maximum number of Agents the Chat model may select into one emergent GroupRun.
EMERGENT_GROUP_MAX_MEMBERS=64
