# Local persistent UAT ports. Keep loopback binding unless LAN access is intentional.
UAT_BIND_HOST=127.0.0.1
UAT_UI_PORT=8181
UAT_API_PORT=8101
UAT_MYSQL_PORT=3310
UAT_REDIS_PORT=6390
UAT_QDRANT_PORT=6335
UAT_OTLP_PORT=4320
UAT_OTEL_HEALTH_PORT=13135
UAT_API_PUBLIC_URL=http://localhost:8101

# Generated per installation by init-env.sh. Never commit actual values.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=myclaw_uat
MYSQL_USER=myclaw_uat
MYSQL_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
REDIS_URL=
SECRET_KEY=
ENCRYPTION_KEY=
INIT_ADMIN_EMAIL=admin@uat.myclaw.local
INIT_ADMIN_PASSWORD=

# Production-mode application configuration.
MYCLAW_ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=["http://localhost:8181","http://127.0.0.1:8181"]
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_UNAUTHENTICATED_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
RUNTIME_WORKER_POLL_SECONDS=0.5
RUNTIME_WORKER_CONCURRENCY=8
RUNTIME_PROVIDER_POOL_MAX_ENTRIES=32
RUNTIME_OUTBOX_CLAIM_LEASE_SECONDS=30
RUNTIME_RUNNER_LEASE_SECONDS=30
RUNTIME_RUNNER_HEARTBEAT_SECONDS=10
SANDBOX_WORKER_POLL_SECONDS=0.5
SANDBOX_OUTBOX_CLAIM_LEASE_SECONDS=30
SANDBOX_ATTEMPT_STALE_SECONDS=60
SKILL_MANIFEST_MAX_BYTES=262144
SKILL_CATALOG_MAX_TOKENS=600
SKILL_SYNC_WORKER_POLL_SECONDS=1
SKILL_SYNC_CLAIM_LEASE_SECONDS=30
SKILL_SYNC_RECONCILE_SECONDS=3600
KNOWLEDGE_QDRANT_API_KEY=
KNOWLEDGE_QDRANT_COLLECTION_PREFIX=myclaw_knowledge
KNOWLEDGE_WORKER_POLL_SECONDS=0.5
KNOWLEDGE_WORKER_CONCURRENCY=2
KNOWLEDGE_INDEX_CLAIM_LEASE_SECONDS=300
KNOWLEDGE_INDEX_HEARTBEAT_SECONDS=30
KNOWLEDGE_EMBEDDING_TIMEOUT_SECONDS=60
MAINTENANCE_POLL_SECONDS=3600
MAINTENANCE_COMMAND_POLL_SECONDS=1
MAINTENANCE_COMMAND_CLAIM_LEASE_SECONDS=300
MAINTENANCE_COMMAND_HEARTBEAT_SECONDS=30
MAINTENANCE_BATCH_SIZE=500
OUTBOX_COMPLETED_RETENTION_DAYS=30
OUTBOX_DEAD_RETENTION_DAYS=180
CHECKPOINT_RETENTION_DAYS=30
TRACE_RETENTION_DAYS=30
DELIVERY_ATTEMPT_RETENTION_DAYS=90
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_HEADERS=
MYCLAW_RELEASE=uat-local
# Docker Desktop maps public DNS answers into this synthetic forwarding range.
# MyClaw still rejects literal URLs in the range and pins the validated answer.
TRUSTED_SYNTHETIC_DNS_CIDRS=["198.18.0.0/15"]

# These values are consumed only by the local acceptance runner. Runtime
# containers do not receive model credentials as ambient environment; the
# administrator API encrypts api_key into the platform Secret store.
MYCLAW_REAL_LLM_API_KEY=
MYCLAW_REAL_LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
MYCLAW_REAL_LLM_MODEL=qwen3.5-plus
MYCLAW_REAL_LLM_PARAMETERS={"temperature":0,"max_tokens":4096,"extra_body":{"enable_thinking":true}}
MYCLAW_REAL_EMBEDDING_MODEL=text-embedding-v4
MYCLAW_REAL_EMBEDDING_DIMENSIONS=1024
